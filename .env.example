# `npm run up` reads these values from the running local stack and passes them
# to the application, so copying this file is not required to start working.
# Copy it to .env when running `npm run dev` or `npm start` on their own: both
# load .env automatically if present.
# The API refuses to start if a required variable is missing, naming it.
#
# The values below are the local Supabase defaults: `npm run db:start` prints
# them, and they are identical on every machine, so they are not secrets.
# Production values come from the Supabase dashboard and must never be committed.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# The broker declared in compose.yaml, reachable on the loopback interface only.
REDIS_URL=redis://127.0.0.1:6379

# Host port for that broker. Override it when the machine already runs a Redis
# of its own on the default port, otherwise `npm run up` cannot publish it.
REDIS_PORT=6379

# Optional. pino level, defaults to "info".
LOG_LEVEL=info
