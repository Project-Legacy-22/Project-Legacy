# Reference of every variable the application reads. It carries no value: a
# placeholder cannot leak, and it cannot go stale either, which a copied key
# would the day the stack regenerates it.
#
# `npm run up` reads the local values from the running stack and passes them to
# the application, so this file does not have to be copied to start working.
# Copy it to .env only to run `npm run dev` or `npm start` on their own; both
# load .env automatically if present. `npm run db:start` prints the local
# values, and `supabase status -o env` prints them again at any time.
#
# The API refuses to start if a required variable is missing, naming it.
# Production values come from the Supabase dashboard and are never committed.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Public by design: the key a browser would carry. The authentication
# adapter uses it so that sign-up and sign-in go through the project's
# password policy, which the service-role key would bypass.
SUPABASE_ANON_KEY=

# The broker declared in compose.yaml, reachable on the loopback interface only.
# Required by whoever relays or consumes: the API refuses to start() without it,
# and the worker refuses to load at all. A deployment that only serves HTTP --
# the serverless function, which cannot host the relay's interval -- may leave it
# unset, since no route touches the bus.
REDIS_URL=redis://127.0.0.1:6379

# Le relais SMTP derriere GoTrue (#149). En developpement ces valeurs pointent le
# capteur de la pile locale : les e-mails y sont gardes et visibles sur
# http://127.0.0.1:54324, aucun ne part. Au deploiement, `supabase config push`
# est lance avec les valeurs de Resend -- hote smtp.resend.com, port 587,
# utilisateur resend, mot de passe la cle d API.
SUPABASE_AUTH_SMTP_HOST=127.0.0.1
SUPABASE_AUTH_SMTP_PORT=54325
SUPABASE_AUTH_SMTP_USER=capteur-local
SUPABASE_AUTH_SMTP_PASS=capteur-local
SUPABASE_AUTH_SMTP_ADMIN_EMAIL=no-reply@legacy22.test

# Secret que le workflow planifie presente pour declencher une passe de
# livraison, sur une cible ou aucun processus ne fait tourner le relais.
# Absent, la route /internal/relay n est pas montee. 32 caracteres minimum.
RELAY_SECRET=

# How long the worker blocks waiting for an event before looping. Optional.
WORKER_BLOCK_SECONDS=5

# Host port for that broker. Override it when the machine already runs a Redis
# of its own on the default port, otherwise `npm run up` cannot publish it.
REDIS_PORT=6379

# Optional. In production the session cookie is marked Secure, which a
# browser drops over plain http. Defaults to "development".
NODE_ENV=development

# Optional. pino level, defaults to "info".
LOG_LEVEL=info

# Optional. The one browser origin allowed to call the API cross-origin. The
# front is served from the API's own origin everywhere, so this only ever serves
# to refuse everything else. Never a wildcard. Defaults to the Vite dev server;
# in production, set it to the deployed origin.
WEB_ORIGIN=http://localhost:5173

# Optional. How many reverse-proxy hops in front of the process may set
# X-Forwarded-For, which is how the caller's address -- the rate limiter's
# client key -- is derived. Defaults to 0 (direct connection, no forwarded
# header trusted). Behind one proxy in production, set it to 1.
TRUST_PROXY=0
