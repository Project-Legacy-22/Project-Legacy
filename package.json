{
  "name": "legacy-todo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/contracts",
    "packages/infra",
    "packages/core/items"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "nodemon -L --watch apps/api --watch packages --ext ts --exec \"tsx --env-file-if-exists=.env --conditions=development apps/api/src/index.ts\"",
    "dev:web": "npm run dev --workspace @legacy/web",
    "build": "tsc --build && npm run build --workspace @legacy/web",
    "start": "node --env-file-if-exists=.env apps/api/dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --build && tsc -p tsconfig.test.json && npm run typecheck --workspace @legacy/web && node scripts/check-layers.mjs",
    "test": "vitest run --coverage",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --level warning",
    "db:types": "node scripts/db-types.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.9.6",
    "supabase": "^2.116.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "tar": "7.5.22",
    "glob": "11.1.0",
    "semver": "7.5.2",
    "cross-spawn": "7.0.5",
    "braces": "3.0.3",
    "http-cache-semantics": "4.1.1",
    "socks": "2.8.10"
  }
}
