{
  "name": "legacy-todo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "apps/api",
    "packages/contracts",
    "packages/infra",
    "packages/core/items"
  ],
  "scripts": {
    "dev": "nodemon -L --watch apps --watch packages --ext ts --exec \"tsx --conditions=development apps/api/src/index.ts\"",
    "build": "tsc --build && node scripts/copy-static.mjs",
    "start": "node apps/api/dist/index.js",
    "typecheck": "tsc --build && node scripts/check-layers.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "overrides": {
    "tar": "7.5.4",
    "glob": "11.1.0",
    "semver": "7.5.2",
    "cross-spawn": "7.0.5",
    "braces": "3.0.3",
    "http-cache-semantics": "4.1.1",
    "socks": "2.8.1"
  }
}
