{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "vite",
    "installCommand": "npm ci",
    "buildCommand": "npm run build",
    "outputDirectory": "apps/api/dist/static",
    "rewrites": [
        {
            "source": "/auth/(.*)",
            "destination": "/api"
        },
        {
            "source": "/items(.*)",
            "destination": "/api"
        }
    ],
    "ignoreCommand": "test \"$VERCEL_GIT_PREVIOUS_SHA\" != \"$VERCEL_GIT_COMMIT_SHA\" && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- api apps packages package-lock.json vercel.json"
}
